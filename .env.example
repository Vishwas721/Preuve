# Copy to `.env` (repo root) and fill in. `.env` is git-ignored.

# --- Infra (docker compose) ---
POSTGRES_USER=preuve
POSTGRES_PASSWORD=preuve
POSTGRES_DB=preuve
SEARXNG_SECRET=replace-with-a-long-random-string

# --- API ---
DATABASE_URL=postgresql+asyncpg://preuve:preuve@localhost:5432/preuve
REDIS_URL=redis://localhost:6379/0
SEARXNG_URL=http://localhost:8888
CORS_ORIGINS=http://localhost:3000

# --- LLM: local (Ollama) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b

# --- LLM: Gemini free tier (leave empty to disable) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:8000
