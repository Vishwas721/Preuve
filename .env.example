# Copy to `.env` (repo root) and fill in. `.env` is git-ignored.

# --- Infra (docker compose) ---
POSTGRES_USER=preuve
POSTGRES_PASSWORD=preuve
POSTGRES_DB=preuve
# Host port; 5433 avoids clashing with a locally installed Postgres on 5432.
POSTGRES_PORT=5433
SEARXNG_SECRET=replace-with-a-long-random-string

# --- API ---
# Use 127.0.0.1, not localhost: on Windows, Docker port forwarding over IPv6 (::1) can time out.
DATABASE_URL=postgresql+asyncpg://preuve:preuve@127.0.0.1:5433/preuve
REDIS_URL=redis://127.0.0.1:6379/0
SEARXNG_URL=http://127.0.0.1:8888
CORS_ORIGINS=http://localhost:3000

# --- LLM: local (Ollama) ---
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3:8b
OLLAMA_NUM_CTX=8192

# --- LLM: Gemini free tier (leave empty to disable) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:8000
