# Copy to `.env` (repo root) and fill in. `.env` is git-ignored.

# --- Infra (docker compose) ---
POSTGRES_USER=preuve
POSTGRES_PASSWORD=preuve
POSTGRES_DB=preuve
# Host ports, chosen to avoid other local projects (5432-5434, 6379-6380 are taken).
POSTGRES_PORT=5435
REDIS_PORT=6381
SEARXNG_SECRET=replace-with-a-long-random-string

# --- API ---
# Use 127.0.0.1, not localhost: on Windows, Docker port forwarding over IPv6 (::1) can time out.
DATABASE_URL=postgresql+asyncpg://preuve:preuve@127.0.0.1:5435/preuve
REDIS_URL=redis://127.0.0.1:6381/0
SEARXNG_URL=http://127.0.0.1:8888
CORS_ORIGINS=http://localhost:3000

# --- LLM: local (Ollama) ---
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_NUM_CTX=8192

# --- LLM: Gemini free tier (leave empty to disable) ---
GEMINI_API_KEY=
# Fallback chain, tried in order (a failing model cools down, then is retried)
GEMINI_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-2.5-flash
GEMINI_TIMEOUT_S=45
GEMINI_COOLDOWN_S=300

# --- LLM routing (see apps/api/app/llm/tasks.py) ---
# Per-task overrides as JSON, e.g. {"analyze_idea":"local"}
LLM_ROUTE_OVERRIDES={}
# Let Gemini tasks fall back to the local model when Gemini is unavailable
LLM_ALLOW_DOWNGRADE=true

# --- Outreach email (Phase 2) ---
# Dev: Mailpit from docker compose catches everything (UI on http://localhost:8025).
# Real sends: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_STARTTLS=true and a Gmail app password.
# Leave SMTP_HOST empty to disable sending.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_SSL=false
# Transparent sender identity: your real name and address.
EMAIL_FROM_NAME=
EMAIL_FROM_ADDRESS=
# Optional postal address line in the footer.
EMAIL_POSTAL_ADDRESS=
# Signs unsubscribe links. Use a long random string.
OUTREACH_SECRET=replace-with-a-long-random-string
# Public base URL of the API, used in unsubscribe links.
PUBLIC_API_URL=http://localhost:8000
OUTREACH_DAILY_LIMIT=20
OUTREACH_COOLDOWN_DAYS=30

# --- Reply ingestion (Phase 3) ---
# Dev: GreenMail from docker compose. Real: IMAP_HOST=imap.gmail.com, IMAP_PORT=993, IMAP_SSL=true,
# same Gmail address and app password. Leave IMAP_HOST empty to disable polling.
IMAP_HOST=127.0.0.1
IMAP_PORT=3143
IMAP_SSL=false
IMAP_USERNAME=founder@preuve.local
IMAP_PASSWORD=secret
IMAP_FOLDER=INBOX
IMAP_POLL_MINUTES=5
# Replies and interview notes are private: they stay on the local model unless this is true.
ALLOW_PRIVATE_TO_GEMINI=false

# --- Accounts (Phase 5A) ---
# Open sign-up; off means people join through a workspace owner's invitation link.
ALLOW_SIGNUP=false

# --- Web ---
# The web app calls the API same-origin at /api; Next proxies it here (Phase 5A).
PREUVE_API_INTERNAL_URL=http://127.0.0.1:8000
