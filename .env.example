# Copy to `.env` (repo root) and fill in. `.env` is git-ignored.

# --- Infra (docker compose) ---
POSTGRES_USER=preuve
POSTGRES_PASSWORD=preuve
POSTGRES_DB=preuve
# Host ports, chosen to avoid other local projects (5432-5434, 6379-6380 are taken).
POSTGRES_PORT=5435
REDIS_PORT=6381
SEARXNG_SECRET=replace-with-a-long-random-string

# --- API ---
# Use 127.0.0.1, not localhost: on Windows, Docker port forwarding over IPv6 (::1) can time out.
DATABASE_URL=postgresql+asyncpg://preuve:preuve@127.0.0.1:5435/preuve
REDIS_URL=redis://127.0.0.1:6381/0
SEARXNG_URL=http://127.0.0.1:8888
CORS_ORIGINS=http://localhost:3000

# --- LLM: local (Ollama) ---
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_NUM_CTX=8192

# --- LLM: Gemini free tier (leave empty to disable) ---
GEMINI_API_KEY=
# Fallback chain, tried in order (a failing model cools down, then is retried)
GEMINI_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-2.5-flash
GEMINI_TIMEOUT_S=45
GEMINI_COOLDOWN_S=300

# --- LLM routing (see apps/api/app/llm/tasks.py) ---
# Per-task overrides as JSON, e.g. {"analyze_idea":"local"}
LLM_ROUTE_OVERRIDES={}
# Let Gemini tasks fall back to the local model when Gemini is unavailable
LLM_ALLOW_DOWNGRADE=true

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:8000
