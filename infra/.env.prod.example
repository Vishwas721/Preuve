# Production settings for infra/docker-compose.prod.yml (Phase 5D).
# Copy to infra/.env.prod (git-ignored) and fill in. Generate secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# --- Images: CI builds on GHCR by default. For images built here (deploy.sh --build), use
# PREUVE_API_IMAGE=preuve-api, PREUVE_WEB_IMAGE=preuve-web and PREUVE_TAG=local. ---
PREUVE_TAG=latest
# PREUVE_API_IMAGE=ghcr.io/vishwas721/preuve-api
# PREUVE_WEB_IMAGE=ghcr.io/vishwas721/preuve-web

# --- Where people reach Preuve ---
WEB_PORT=3100
# The address in the browser bar. Used for sign-in origin checks and unsubscribe links.
PUBLIC_WEB_URL=http://localhost:3100

# --- Secrets (required) ---
POSTGRES_PASSWORD=
OUTREACH_SECRET=
SEARXNG_SECRET=

# --- Models ---
# Ollama on this machine, reached from the containers.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b
GEMINI_API_KEY=
ALLOW_PRIVATE_TO_GEMINI=false

# --- Outreach mail (optional; empty = sending off) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
EMAIL_FROM_NAME=
EMAIL_FROM_ADDRESS=
EMAIL_POSTAL_ADDRESS=
OUTREACH_DAILY_LIMIT=20
IMAP_HOST=
IMAP_USERNAME=
IMAP_PASSWORD=

# --- Accounts ---
ALLOW_SIGNUP=false

# --- Backups ---
# A folder on this machine (relative paths are relative to infra/). Point it at a folder your
# cloud drive syncs for an off-machine copy.
BACKUP_DIR=../backups
BACKUP_HOUR=3
BACKUP_KEEP_DAYS=14

# --- Optional ---
# Error reporting to Sentry (free tier). Empty = off; nothing leaves this machine.
SENTRY_DSN=
# Public HTTPS via Cloudflare Tunnel (needs a domain): start with --profile tunnel.
CLOUDFLARE_TUNNEL_TOKEN=
